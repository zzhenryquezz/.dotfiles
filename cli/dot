  # :command.command_filter
  action=${1:-}

  case $action in
    -*) ;;

    waybar)
      action="waybar"
      shift
      dot_waybar_parse_requirements "$@"
      shift $#
      ;;

    tmux)
      action="tmux"
      shift
      dot_tmux_parse_requirements "$@"
      shift $#
      ;;

    hypr)
      action="hypr"
      shift
      dot_hypr_parse_requirements "$@"
      shift $#
      ;;

    # :command.command_fallback
    "")
      dot_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

